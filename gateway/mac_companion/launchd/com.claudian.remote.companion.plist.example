<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claudian.remote.companion</string>
  <key>ProgramArguments</key>
  <array>
    <string>/absolute/path/to/zhouhuan/gateway/.venv/bin/python</string>
    <string>-m</string>
    <string>gateway.mac_companion.companion</string>
    <string>--config</string>
    <string>/absolute/path/to/zhouhuan/gateway/mac_companion/config.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/absolute/path/to/zhouhuan</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/claudian-remote-companion.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/claudian-remote-companion.err.log</string>
</dict>
</plist>
