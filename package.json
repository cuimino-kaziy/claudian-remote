{
  "name": "claudian-remote",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "test": "npm run build && node --test tests/*.test.js",
    "test:release": "node --test tests/release-contract.test.js",
    "check:source": "node release/packaging/check-source-boundary.mjs .",
    "release:key:init": "node release/packaging/create-signing-key.mjs",
    "release:package": "sh release/packaging/build-assets.sh",
    "release:verify:runtimes": "node release/packaging/verify-runtime-assets.mjs",
    "release:sign": "node release/packaging/sign-release.mjs",
    "release:kit": "node release/packaging/prepare-install-kit.mjs",
    "verify": "npm run check:source && npm test && node --check main.js"
  },
  "devDependencies": {
    "esbuild": "0.25.6",
    "obsidian": "1.12.3"
  }
}
