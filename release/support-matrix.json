{
  "schema_version": 1,
  "release_version": "0.2.0-beta.1",
  "beta_scope": {
    "invited_users_min": 5,
    "invited_users_max": 10,
    "macs_per_installation": 1,
    "mobile_devices_per_installation": 1,
    "vaults_per_installation": 1,
    "desktop_os": ["macOS"],
    "mobile_os": ["iOS", "iPadOS"]
  },
  "plugin": {
    "id": "claudian-remote",
    "migration_source_ids": ["whale-agent-bridge"],
    "legacy_id_may_coexist": false,
    "minimum_obsidian_version": "1.12.3"
  },
  "claudian": {
    "exact_version": "2.0.4",
    "unsupported_mode": "read_only",
    "manifest_schema": 1,
    "required_capabilities": [
      "semantic_stream",
      "completion_barrier",
      "stop",
      "steer",
      "approval",
      "history_list",
      "history_select"
    ]
  },
  "components": {
    "compatibility_set_id": "claudian-remote-0.2.0-beta.1",
    "plugin": "0.2.0-beta.1",
    "companion": "0.2.0-beta.1",
    "relay": "0.2.0-beta.1",
    "installer": "0.2.0-beta.1",
    "configuration_schema": 1
  },
  "protocol": {
    "current": "claudian.remote.v2",
    "compatible": ["claudian.remote.v2"],
    "rollback": ["claudian.remote.v2"]
  },
  "runtime": {
    "python": "3.12.11",
    "uv": "0.10.12",
    "delivery": "private_release_asset",
    "required_assets": [
      {
        "platform": "darwin",
        "arch": "arm64",
        "python": {
          "version": "3.12.11",
          "url_env": "CLAUDIAN_PYTHON_DARWIN_ARM64_URL",
          "sha256_env": "CLAUDIAN_PYTHON_DARWIN_ARM64_SHA256"
        },
        "uv": {
          "version": "0.10.12",
          "url_env": "CLAUDIAN_UV_DARWIN_ARM64_URL",
          "sha256_env": "CLAUDIAN_UV_DARWIN_ARM64_SHA256"
        }
      },
      {
        "platform": "darwin",
        "arch": "x86_64",
        "python": {
          "version": "3.12.11",
          "url_env": "CLAUDIAN_PYTHON_DARWIN_X86_64_URL",
          "sha256_env": "CLAUDIAN_PYTHON_DARWIN_X86_64_SHA256"
        },
        "uv": {
          "version": "0.10.12",
          "url_env": "CLAUDIAN_UV_DARWIN_X86_64_URL",
          "sha256_env": "CLAUDIAN_UV_DARWIN_X86_64_SHA256"
        }
      }
    ]
  },
  "distribution": {
    "allowed_combinations": [
      {
        "distribution_channel": "private_beta",
        "plugin_update_owner": "lifecycle_manager"
      },
      {
        "distribution_channel": "community",
        "plugin_update_owner": "obsidian"
      }
    ]
  },
  "relay_limits": {
    "terminal_recovery_seconds": 3600,
    "stale_in_flight_seconds": 21600,
    "upload_after_terminal_seconds": 1800,
    "upload_absolute_seconds": 7200,
    "max_file_bytes": 268435456,
    "max_outstanding_bytes_per_installation": 536870912,
    "max_concurrent_uploads": 2,
    "max_frame_bytes": 1048576,
    "managed_volume_refusal_percent": 80
  }
}
