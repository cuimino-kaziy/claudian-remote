{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claudian-remote.invalid/schemas/release-manifest-v1.json",
  "title": "Claudian Remote signed release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_tag", "release_version", "source_ref", "distribution_channel", "plugin_update_owner", "compatibility_set", "assets", "signature"],
  "properties": {
    "schema_version": {"const": 1},
    "release_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "release_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "source_ref": {"type": "string", "pattern": "^refs/tags/v"},
    "distribution_channel": {"enum": ["private_beta", "community"]},
    "plugin_update_owner": {"enum": ["lifecycle_manager", "obsidian"]},
    "compatibility_set": {"$ref": "#/$defs/compatibilitySet"},
    "assets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/asset"}
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {"version": {"$ref": "#/$defs/semver"}}
    },
    "compatibilitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "plugin", "companion", "relay", "installer", "protocol", "configuration_schema", "claudian", "runtime", "upgrade_contract"],
      "properties": {
        "id": {"const": "claudian-remote-0.2.0-beta.5"},
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "minimum_obsidian_version"],
          "properties": {
            "id": {"const": "claudian-remote"},
            "version": {"$ref": "#/$defs/semver"},
            "minimum_obsidian_version": {"type": "string"}
          }
        },
        "companion": {"$ref": "#/$defs/component"},
        "relay": {"$ref": "#/$defs/component"},
        "installer": {"$ref": "#/$defs/component"},
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["current", "compatible", "rollback"],
          "properties": {
            "current": {"type": "string", "minLength": 1},
            "compatible": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "rollback": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "configuration_schema": {"type": "integer", "minimum": 1},
        "claudian": {"type": "object", "additionalProperties": false, "required": ["exact_version", "supported_versions"], "properties": {"exact_version": {"const": "2.2.6"}, "supported_versions": {"const": ["2.0.4", "2.2.6"]}}},
        "runtime": {"$ref": "#/$defs/runtimeDistribution"},
        "upgrade_contract": {"$ref": "#/$defs/upgradeContract"}
      }
    },
    "runtimeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/semver"},
        "url": {"type": "string", "pattern": "^https://[^?#]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "python", "uv"],
      "properties": {
        "platform": {"const": "darwin"},
        "arch": {"enum": ["arm64", "x86_64"]},
        "python": {"$ref": "#/$defs/runtimeArtifact"},
        "uv": {"$ref": "#/$defs/runtimeArtifact"}
      }
    },
    "runtimeDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "uv", "delivery", "assets"],
      "properties": {
        "python": {"$ref": "#/$defs/semver"},
        "uv": {"$ref": "#/$defs/semver"},
        "delivery": {"const": "immutable_upstream_asset"},
        "assets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/runtimeTarget"}
        }
      }
    },
    "upgradeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_schema", "journey_capabilities", "result_schema_versions", "proof_schema_versions", "supported_legacy_lineages", "supported_profiles", "final_topology_boundary", "current_update_pairing_rows", "adapter_rows", "helper_rows", "execution_constraints", "packaged_acceptance_rows"],
      "properties": {
        "contract_schema": {"const": "claudian-remote.upgrade-capabilities/v1"},
        "journey_capabilities": {
          "type": "array",
          "prefixItems": [
            {"const": "fresh_install"},
            {"const": "current_update"},
            {"const": "legacy_upgrade"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "result_schema_versions": {"const": ["claudian-remote.lifecycle-result/v2"]},
        "proof_schema_versions": {"const": ["claudian-remote.legacy-retirement-proof/v1"]},
        "supported_legacy_lineages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/legacyLineage"}
        },
        "supported_profiles": {"const": ["local_tailscale"]},
        "final_topology_boundary": {"$ref": "#/$defs/finalTopologyBoundary"},
        "current_update_pairing_rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/currentUpdatePairingRow"}
        },
        "adapter_rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/adapterRow"}
        },
        "helper_rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/helperRow"}
        },
        "execution_constraints": {"$ref": "#/$defs/executionConstraints"},
        "packaged_acceptance_rows": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/packagedAcceptanceRow"}
        }
      }
    },
    "legacyLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "version", "journey"],
      "properties": {
        "plugin_id": {"enum": ["claudian-remote", "whale-agent-bridge"]},
        "version": {"enum": ["0.2.0-beta.4", "recognized-dogfood-lineage"]},
        "journey": {"enum": ["current_update", "legacy_upgrade"]}
      }
    },
    "finalTopologyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "relay_location", "exposure", "silent_fallback"],
      "properties": {
        "mode": {"const": "local_tailscale"},
        "relay_location": {"const": "mac_loopback"},
        "exposure": {"const": "tailscale_serve"},
        "silent_fallback": {"const": false}
      }
    },
    "currentUpdatePairingRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairing_identity_policy", "plugin", "companion", "installer"],
      "properties": {
        "pairing_identity_policy": {"enum": ["preserve", "rotate"]},
        "plugin": {"const": "0.2.0-beta.5"},
        "companion": {"const": "0.2.0-beta.5"},
        "installer": {"const": "0.2.0-beta.5"}
      }
    },
    "adapterRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "adapter"],
      "properties": {
        "profile_id": {"enum": ["dogfood-local-v1", "dogfood-vps-v1"]},
        "adapter": {"enum": ["local_managed_relay", "legacy_vps_relay"]}
      }
    },
    "helperRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "name", "source_path", "delivery", "sha256"],
      "properties": {
        "component": {"const": "legacy_retirement_helper"},
        "name": {"const": "claudian-remote-legacy-retirement-helper-0.2.0-beta.5.py"},
        "source_path": {"const": "gateway/relay/legacy_retirement.py"},
        "delivery": {"const": "signed_kit_asset"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "executionConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_paths_must_be_absolute", "runtime_exact_paths", "runtime_prefixes", "import_paths_must_be_absolute", "import_prefixes", "developer_checkout_dependency", "unbound_network_dependency", "runtime_proof_secret_material"],
      "properties": {
        "runtime_paths_must_be_absolute": {"const": true},
        "runtime_exact_paths": {"const": ["/usr/bin/python3", "/usr/local/bin/python3"]},
        "runtime_prefixes": {"const": ["/opt/claudian-remote/runtime"]},
        "import_paths_must_be_absolute": {"const": true},
        "import_prefixes": {"const": ["/opt/claudian-remote", "/var/lib/claudian-remote/operations"]},
        "developer_checkout_dependency": {"const": "forbidden"},
        "unbound_network_dependency": {"const": "forbidden"},
        "runtime_proof_secret_material": {"const": "excluded"}
      }
    },
    "packagedAcceptanceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey", "components"],
      "properties": {
        "journey": {"enum": ["fresh_install", "current_update", "legacy_upgrade"]},
        "components": {
          "type": "array",
          "minItems": 4,
          "maxItems": 5,
          "items": {"enum": ["plugin", "companion", "relay", "installer", "legacy_retirement_helper"]}
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "component", "sha256", "size", "license", "dependency_locks"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "component": {"enum": ["plugin", "companion", "relay", "installer", "legacy_retirement_helper"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "license": {"enum": ["MIT", "AGPL-3.0-only"]},
        "dependency_locks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lock"}}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_fingerprint", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_fingerprint": {"$ref": "#/$defs/sha256"},
        "value": {"type": "string", "minLength": 1, "contentEncoding": "base64"}
      }
    }
  }
}
